#!/bin/sh

PROG=find-and-replace
DIR="$(cd "$(dirname "$0")" && pwd)"
CFLAGS='-O2'
LFLAGS=""
CC=$(readlink "$(command -v cc)")
if [ "$COVERAGE" = "1" ]; then
	CFLAGS="-O0 --coverage"
	LFLAGS="--coverage"
fi
#shellcheck disable=SC2086
cc "$DIR/$PROG.c" -o "$DIR/$PROG" $CFLAGS -I"$DIR/lib/jstring/build/include" -L"$DIR/lib/jstring/build/lib" -ljstr $LFLAGS || exit
echo "cc $DIR/$PROG.c -o $DIR/$PROG $CFLAGS -I$DIR/lib/jstring/build/include -L$DIR/lib/jstring/build/lib -ljstr $LFLAGS"
