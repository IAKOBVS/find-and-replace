#!/bin/sh

PROG=find-and-replace
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ "$COVERAGE" = "1" ] && [ -z "$COVERAGE_OUTDIR" ]; then
	OUTDIR="$(mktemp -d)"
else
	OUTDIR="${COVERAGE_OUTDIR:-$DIR}"
fi
SRCS='main.c files.c process.c confirm.c procfs.c vim.c'
NP=$(nproc 2>/dev/null || echo 2)
CFLAGS="-I$DIR/lib/jstring/build/include -march=native -O2 -Wpedantic -pedantic -Wall -Wextra -Wuninitialized -Wshadow -Warray-bounds -Wnull-dereference -Wformat -Wunused -Wwrite-strings"
JSTR_LIB="-L$DIR/lib/jstring/build/lib -Wl,-rpath,$DIR/lib/jstring/build/lib"
LFLAGS=""
CC=$(readlink "$(command -v cc)")
if [ "$COVERAGE" = "1" ]; then
	CFLAGS="-O0 --coverage"
	LFLAGS="--coverage"
fi
# Headers and library come from the pinned lib/jstring checkout.
export DIR OUTDIR INC CFLAGS

# Compile each translation unit in parallel (xargs -P, capped at nproc), then link.
#shellcheck disable=SC2046
if ! printf '%s\n' $SRCS | xargs -P "$NP" -n 1 sh -c '
	compile_one() {
		src="$1"
		cc -c "$DIR/$src" -o "$OUTDIR/${src%.c}.o" $CFLAGS
	}
	compile_one "$1"
' _; then
	exit 1
fi

OBJS=""
for src in $SRCS; do
	OBJS="$OBJS $OUTDIR/${src%.c}.o"
done
#shellcheck disable=SC2086
cc $OBJS -o "$OUTDIR/$PROG" $JSTR_LIB -ljstr $LFLAGS || exit 1
echo "cc $SRCS -o $OUTDIR/$PROG $CFLAGS -ljstr $LFLAGS (parallel xargs -P $NP)"
