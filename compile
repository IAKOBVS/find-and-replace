#!/bin/sh

PROG=find-and-replace
DIR="$(cd "$(dirname "$0")" && pwd)"
OUTDIR="${COVERAGE_OUTDIR:-$DIR}"
SRCS='main.c files.c process.c confirm.c procfs.c vim.c'
TEST_SRCS='tests/pty_driver.c tests/err_helper.c'
NP=$(nproc 2>/dev/null || echo 2)
CFLAGS='-march=native -O2 -Wpedantic -pedantic -Wall -Wextra -Wuninitialized -Wshadow -Warray-bounds -Wnull-dereference -Wformat -Wunused -Wwrite-strings'
LFLAGS=""
CC=$(readlink "$(command -v cc)")
if [ "$COVERAGE" = "1" ]; then
	CFLAGS="-O0 --coverage"
	LFLAGS="--coverage"
fi
# Headers and library come from the pinned lib/jstring checkout.
JSTR_INC="-I $DIR/lib/jstring/build/include"
JSTR_LIB="-L $DIR/lib/jstring/build/lib"
export DIR OUTDIR JSTR_INC CFLAGS

# Compile all translation units in parallel (xargs -P, capped at nproc).
#shellcheck disable=SC2046
if ! printf '%s\n' $SRCS $TEST_SRCS | xargs -P "$NP" -n 1 sh -c '
	compile_one() {
		src="$1"
		out="${src%.c}.o"
		mkdir -p "$OUTDIR/$(dirname "$out")"
		if [ "${src#tests/}" != "$src" ]; then
			cc -c "$DIR/$src" -o "$OUTDIR/$out" $CFLAGS
		else
			cc -c "$DIR/$src" -o "$OUTDIR/$out" $JSTR_INC $CFLAGS
		fi
	}
	compile_one "$1"
' _; then
	exit 1
fi

OBJS=""
for src in $SRCS; do
	OBJS="$OBJS $OUTDIR/${src%.c}.o"
done

# Link main executable and test helpers in parallel
{
	cc $OBJS -o "$OUTDIR/$PROG" $JSTR_LIB -ljstr $LFLAGS &
	cc "$OUTDIR/tests/pty_driver.o" -o "$OUTDIR/tests/pty_driver" $LFLAGS &
	cc "$OUTDIR/tests/err_helper.o" -o "$OUTDIR/tests/err_helper" $LFLAGS &
	wait
} || exit 1

echo "cc $SRCS -o $OUTDIR/$PROG (parallel xargs -P $NP)"
