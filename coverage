#!/bin/sh
# Build with coverage support, run all tests, and report line coverage.

set -e

PROG=find-and-replace
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

TMPDIR=$(mktemp -d) && trap 'rm -rf "$TMPDIR"; rm -f "$DIR/$PROG"' EXIT

# Build with coverage flags — .gcno lands in TMPDIR
echo "=== Building with coverage support ==="
COVERAGE=1 COVERAGE_OUTDIR="$TMPDIR" ./compile

# Copy binary so tests can find it at the usual path
cp "$TMPDIR/$PROG" "$DIR/$PROG"

# Run all tests (parallel via test runner)
echo "=== Running all tests ==="
./test 2>/dev/null || true
wait

# Generate gcov report from TMPDIR
echo ""
echo "=== gcov line coverage ==="
(
    cd "$TMPDIR"
    gcov -o "$TMPDIR" "$DIR/find-and-replace.c" 2>/dev/null
)
GCOV="$TMPDIR/find-and-replace.c.gcov"

echo ""
echo "=== Coverage Summary ==="
if [ -f "$GCOV" ]; then
    total=$(wc -l < "$GCOV")
    executed=$(grep -cE '^[[:space:]]*[0-9]+[*]?:' "$GCOV")
    not_executed=$(grep -c '^    #####:' "$GCOV")
    pct=$(awk "BEGIN {printf \"%.1f\", 100 * $executed / ($executed + $not_executed)}")
    echo "  Total lines        : $total"
    echo "  Executed           : $executed"
    echo "  Not executed       : $not_executed"
    echo "  Line coverage      : ${pct}%"
    echo ""
    echo "=== Lines NOT covered ==="
    grep '^    #####' "$GCOV" | head -40
else
    echo "  No gcov output found."
fi

# Rebuild production binary
echo ""
echo "=== Rebuilding production binary ==="
./compile
