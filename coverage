#!/bin/sh
# Build with coverage support, run all tests (parallel), report line + branch coverage.

set -e

PROG=find-and-replace
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

SRCS='main.c files.c process.c confirm.c procfs.c vim.c'

TMPDIR=$(mktemp -d) && trap 'rm -rf "$TMPDIR"' EXIT

# Build with coverage flags — .gcno lands in TMPDIR
echo "=== Building with coverage support ==="
COVERAGE=1 COVERAGE_OUTDIR="$TMPDIR" ./compile

# Copy binary so tests can find it at the usual path
cp "$TMPDIR/$PROG" "$DIR/$PROG"

# Run all tests (parallel via test runner)
echo "=== Running all tests ==="
./test 2>/dev/null || true
wait

# Generate gcov report from TMPDIR
echo ""
echo "=== gcov line + branch coverage ==="
(
    cd "$TMPDIR"
    for src in $SRCS; do
        gcov -b -o "$TMPDIR" "$DIR/$src" 2>/dev/null
    done
)

echo ""
echo "=== Coverage Summary ==="
line_total=0
line_miss=0
br_total=0
br_exec=0
br_taken=0
for src in $SRCS; do
    gc="$TMPDIR/${src%.c}.c.gcov"
    [ -f "$gc" ] || continue
    le=$(grep -cE '^[[:space:]]*[0-9]+[*]?:' "$gc" || true)
    lm=$(grep -c '^    #####:' "$gc" || true)
    line_total=$((line_total + le + lm))
    line_miss=$((line_miss + lm))
    bt=$(awk '/Branches executed:/{print $4}' "$gc")
    bp=$(awk '/Branches executed:/{gsub("%","",$2); split($2,a,":"); print a[2]}' "$gc")
    tp=$(awk '/Taken at least once:/{gsub("%","",$2); split($2,a,":"); print a[2]}' "$gc")
    be=$(awk -v t="$bt" -v p="$bp" 'BEGIN{printf "%d", t*p/100+0.5}')
    bk=$(awk -v t="$bt" -v p="$tp" 'BEGIN{printf "%d", t*p/100+0.5}')
    br_total=$((br_total + bt))
    br_exec=$((br_exec + be))
    br_taken=$((br_taken + bk))
done
lpct=$(awk "BEGIN {printf \"%.1f\", 100 * ($line_total - $line_miss) / $line_total}")
bpct=$(awk "BEGIN {printf \"%.1f\", 100 * $br_exec / $br_total}")
btpct=$(awk "BEGIN {printf \"%.1f\", 100 * $br_taken / $br_total}")
echo "  Line coverage       : $lpct% ($((line_total - line_miss))/$line_total executed)"
echo "  Branch coverage     : $bpct% ($br_exec/$br_total branches executed)"
echo "  Both-paths coverage : $btpct% ($br_taken/$br_total branches taken both ways)"
echo ""
echo "=== Per-file ==="
for src in $SRCS; do
    gc="$TMPDIR/${src%.c}.c.gcov"
    [ -f "$gc" ] || continue
    le=$(grep -cE '^[[:space:]]*[0-9]+[*]?:' "$gc" || true)
    lm=$(grep -c '^    #####:' "$gc" || true)
    bt=$(awk '/Branches executed:/{print $4}' "$gc")
    bp=$(awk '/Branches executed:/{gsub("%","",$2); split($2,a,":"); print a[2]}' "$gc")
    tp=$(awk '/Taken at least once:/{gsub("%","",$2); split($2,a,":"); print a[2]}' "$gc")
    lp=$(awk -v e="$le" -v m="$lm" 'BEGIN{printf "%.1f", 100*e/(e+m)}')
    bp2=$(awk -v t="$bt" -v p="$bp" 'BEGIN{printf "%.1f", t*p/100}')
    tp2=$(awk -v t="$bt" -v p="$tp" 'BEGIN{printf "%.1f", t*p/100}')
    printf '  %-10s lines %s%% (%d/%d)   branches %s%%/%s%% (%d)\n' "$src" "$lp" "$le" "$((le+lm))" "$bp2" "$tp2" "$bt"
done

echo ""
echo "=== Lines NOT covered ==="
grep '^    #####' "$TMPDIR"/*.c.gcov | head -60 || true

# Rebuild production binary
echo ""
echo "=== Rebuilding production binary ==="
./compile
