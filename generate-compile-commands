#!/usr/bin/env python3
"""Generate compile_commands.json from the Makefile's compile commands."""

import json
import os
import shlex
import subprocess
import sys


def main() -> int:
    root = os.path.dirname(os.path.abspath(__file__))
    out_path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, "compile_commands.json")

    try:
        text = subprocess.check_output(
            ["make", "-B", "-n"], cwd=root, text=True, stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"generate-compile-commands: make -B -n failed: {exc}", file=sys.stderr)
        return 1

    entries = []
    seen = set()
    for raw in text.splitlines():
        line = raw.strip()
        if " -c " not in line:
            continue
        try:
            args = shlex.split(line)
        except ValueError:
            continue
        if "-c" not in args or "-o" not in args:
            continue
        ci = args.index("-c")
        oi = args.index("-o")
        if ci + 1 >= len(args) or oi + 1 >= len(args):
            continue
        src = args[ci + 1]
        output = args[oi + 1]
        if not os.path.isabs(src):
            src = os.path.join(root, src)
        src = os.path.normpath(src)
        if src in seen:
            continue
        seen.add(src)
        entries.append(
            {
                "directory": root,
                "file": src,
                "output": output if os.path.isabs(output) else os.path.join(root, output),
                "command": line,
            }
        )

    entries.sort(key=lambda entry: entry["file"])
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(entries, f, indent=2)
        f.write("\n")
    print(f"wrote {out_path} ({len(entries)} entries)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
