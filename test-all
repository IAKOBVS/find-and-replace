#!/bin/sh
# Run the normal suite, both sanitizer unit suites, and both sanitized
# integration suites. Usage: ./test-all [FUZZ_ITERATIONS]
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"
FZ=${1:-250}
DIR="$(cd "$(dirname "$0")" && pwd)"
fail=0

if ! make doc-check; then
	fail=1
fi
if ! ./test "$FZ"; then
	fail=1
fi
if ! ./tests/unit/run.sh; then
	fail=1
fi
if ! ./test-tsan; then
	fail=1
fi
if ! ./test-asan; then
	fail=1
fi
if ! ./test-integration-sanitized all; then
	fail=1
fi
if ! env PROG="$DIR/build-asan/find-and-replace" ASAN_OPTIONS=halt_on_error=1:detect_leaks=0 ./tests/fuzz.sh 5; then
	fail=1
fi

if [ "$fail" -ne 0 ]; then
	echo "test-all: FAILED" >&2
	exit 1
fi
echo "test-all: PASSED"
