#!/bin/sh

# Update the globally-installed jstring dependency to the latest upstream.
# Runs with sudo (writes to /usr/local).
if [ "$(id -u)" -ne 0 ]; then
	echo "Please run the command with sudo, as it requires permission to install to /usr/local"
	exit 1
fi

td=$(mktemp -d)
trap 'rm -rf "$td"' EXIT
git clone https://github.com/IAKOBVS/jstring "$td/jstring"
cd "$td/jstring" || exit
./compile && ./test && ./install